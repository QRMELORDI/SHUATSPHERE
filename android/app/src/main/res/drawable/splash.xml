<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#7C3AED"
                android:centerColor="#3B82F6"
                android:endColor="#0D9488"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <rotate android:fromDegrees="0" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="oval">
                <stroke android:width="6dp" android:color="#FFFFFF" />
            </shape>
        </rotate>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <rotate android:fromDegrees="90" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="oval">
                <stroke android:width="4dp" android:color="#FFFFFF" android:alpha="0.6" />
            </shape>
        </rotate>
    </item>
    <item android:gravity="center" android:width="120dp" android:height="120dp">
        <rotate android:fromDegrees="0" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="oval">
                <stroke android:width="4dp" android:color="#FFFFFF" android:alpha="0.6" />
            </shape>
        </rotate>
    </item>
</layer-list>
